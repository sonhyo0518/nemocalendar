NEXT_PUBLIC_GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"

# Local: leave unset — next.config.mjs rewrites /api/* to localhost:5000
# Production (Vercel): required, e.g. https://nemocalendar-api.onrender.com
# NEXT_PUBLIC_API_URL="https://nemocalendar-api.onrender.com"

# next/image remotePatterns용 (R2 공개 URL의 origin과 동일)
# NEXT_PUBLIC_R2_PUBLIC_BASE_URL="https://your-public-domain.example.com"